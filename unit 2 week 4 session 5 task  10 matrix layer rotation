import java.io.*;
import java.math.*;
import java.security.*;
import java.text.*;
import java.util.*;
import java.util.concurrent.*;
import java.util.function.*;
import java.util.regex.*;
import java.util.stream.*;
import static java.util.stream.Collectors.joining;
import static java.util.stream.Collectors.toList;

class Result {
    public static void matrixRotation(List<List<Integer>> matrix, int r) {
        int m = matrix.size();
        int n = matrix.get(0).size();
        int[][] res = new int[m][n];
        
        int numLayers = Math.min(m, n) / 2;
        
        for (int layer = 0; layer < numLayers; layer++) {
            int top = layer;
            int bottom = m - 1 - layer;
            int left = layer;
            int right = n - 1 - layer;
            
            List<int[]> coords = new ArrayList<>();
            
            // Traversal order in counter-clockwise direction
            // 1. Left column down
            for (int i = top; i < bottom; i++) {
                coords.add(new int[]{i, left});
            }
            // 2. Bottom row right
            for (int j = left; j < right; j++) {
                coords.add(new int[]{bottom, j});
            }
            // 3. Right column up
            for (int i = bottom; i > top; i--) {
                coords.add(new int[]{i, right});
            }
            // 4. Top row left
            for (int j = right; j > left; j--) {
                coords.add(new int[]{top, j});
            }
            
            int len = coords.size();
            int shift = r % len;
            
            // Map original coordinates to their shifted target coordinates
            for (int i = 0; i < len; i++) {
                int origIdx = (i - shift + len) % len;
                int[] targetPos = coords.get(i);
                int[] srcPos = coords.get(origIdx);
                
                res[targetPos[0]][targetPos[1]] = matrix.get(srcPos[0]).get(srcPos[1]);
            }
        }
        
        // Print resultant matrix
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                sb.append(res[i][j]).append(j == n - 1 ? "" : " ");
            }
            sb.append("\n");
        }
        System.out.print(sb);
    }
}
public class Solution {
    public static void main(String[] args) throws IOException {
        BufferedReader bufferedReader = new BufferedReader(new InputStreamReader(System.in));

        String[] firstMultipleInput = bufferedReader.readLine().replaceAll("\\s+$", "").split(" ");

        int m = Integer.parseInt(firstMultipleInput[0]);

        int n = Integer.parseInt(firstMultipleInput[1]);

        int r = Integer.parseInt(firstMultipleInput[2]);

        List<List<Integer>> matrix = new ArrayList<>();

        IntStream.range(0, m).forEach(i -> {
            try {
                matrix.add(
                    Stream.of(bufferedReader.readLine().replaceAll("\\s+$", "").split(" "))
                        .map(Integer::parseInt)
                        .collect(toList())
                );
            } catch (IOException ex) {
                throw new RuntimeException(ex);
            }
        });

        Result.matrixRotation(matrix, r);

        bufferedReader.close();
    }
}
