import java.util.Scanner;
import java.util.ArrayList;
import java.util.LinkedList;
import java.util.Queue;

public class task_8_Smart_traffic_Navigation {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        if (!scanner.hasNextInt()) return;
        int vertices = scanner.nextInt();
        int edges = scanner.nextInt();

        // Initialize adjacency list for the traffic graph
        ArrayList<ArrayList<Integer>> adj = new ArrayList<>();
        for (int i = 0; i <= vertices; i++) {
            adj.add(new ArrayList<>());
        }

        // Read all road connections (edges)
        for (int i = 0; i < edges; i++) {
            int u = scanner.nextInt();
            int v = scanner.nextInt();
            // Assuming bidirectional (two-way) traffic roads
            adj.get(u).add(v);
            adj.get(v).add(u);
        }

        // Read the query route: source and destination
        int source = scanner.nextInt();
        int destination = scanner.nextInt();

        // Perform BFS to check if destination is reachable from source
        if (hasPath(adj, source, destination, vertices)) {
            System.out.println("Yes");
        } else {
            System.out.println("No");
        }

        scanner.close();
    }

    private static boolean hasPath(ArrayList<ArrayList<Integer>> adj, int start, int end, int totalVertices) {
        if (start == end) return true;

        boolean[] visited = new boolean[totalVertices + 1];
        Queue<Integer> queue = new LinkedList<>();

        queue.add(start);
        visited[start] = true;

        while (!queue.isEmpty()) {
            int current = queue.poll();

            if (current == end) {
                return true;
            }

            for (int neighbor : adj.get(current)) {
                if (!visited[neighbor]) {
                    visited[neighbor] = true;
                    queue.add(neighbor);
                }
            }
        }

        return false;
    }
}
