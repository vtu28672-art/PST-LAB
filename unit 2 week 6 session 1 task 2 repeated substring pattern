class Solution {
    public boolean repeatedSubstringPattern(String s) {
        int n = s.length();
        int[] lps = new int[n];
        int len = 0, i = 1;

        // Build Longest Prefix Suffix (LPS) array
        while (i < n) {
            if (s.charAt(i) == s.charAt(len)) {
                len++;
                lps[i] = len;
                i++;
            } else {
                if (len != 0) {
                    len = lps[len - 1];
                } else {
                    lps[i] = 0;
                    i++;
                }
            }
        }

        int longestLPS = lps[n - 1];
        int patternLength = n - longestLPS;

        // Valid if LPS exists and divides the string length perfectly
        return longestLPS > 0 && (n % patternLength == 0);
    }
}
